  "version": "1.5.23",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/pre_build_sync_version.mjs && vite build && node scripts/post_build_prepare_hosting.mjs",
    "lint": "oxlint",
    "test": "node scripts/run_all_tests.mjs",
    "preview": "vite preview",
    "audit-deps": "npx npm-check-updates",
    "update-deps": "npx npm-check-updates -u",
    "deploy": "npm run build && firebase deploy --only hosting",
