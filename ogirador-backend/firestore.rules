rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOrMestre() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().role == 'mestre' || 
          getUserData().role == 'super-admin' || 
          getUserData().role == 'admin' ||
          getUserData().role == 'bureau' ||
          getUserData().role == 'ca' ||
          getUserData().isSystemAdmin == true ||
          (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny([
            'Bureau', 'PrÃƒÂ©sident', 'PrÃƒÂ©sidente', 'PrÃƒÂ©sidence', 'CA', 'Direction', 'Admin'
          ]))
        );
    }

    function hasAnyTag(tagList) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().keys().hasAny(['tags']) &&
        getUserData().tags.hasAny(tagList);
    }

    function canManageEvents() {
      return isAdminOrMestre() || hasAnyTag([
        'Agenda', 'Agenda & Ãƒâ€°vÃƒÂ©nements', 'Bureau', 'PrÃƒÂ©sident', 'PrÃƒÂ©sidente', 'CA', 'Direction', 'Admin'
      ]);
    }

    function canManageInventory() {
      return isAdminOrMestre() || hasAnyTag([
        'Inventaire', 'Logistique', 'MatÃƒÂ©riel', 'Instruments', 'Commandes', 'Bureau', 'CA', 'Direction'
      ]);
    }

    function canManageTreasury() {
      return isAdminOrMestre() || hasAnyTag([
        'TrÃƒÂ©sorerie', 'TrÃƒÂ©sorier', 'TrÃƒÂ©soriÃƒÂ¨re', 'Comptable', 'Finance', 'Bureau', 'CA', 'Direction'
      ]);
    }

    function canManageDocs() {
      return isAdminOrMestre() || hasAnyTag([
        'SecrÃƒÂ©tariat', 'Comptes-Rendus', 'Studio', 'Communication', 'Bureau', 'CA', 'Direction'
      ]);
    }

    function isModerator() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().role == 'mestre' || 
          getUserData().role == 'super-admin' || 
          getUserData().isSystemAdmin == true ||
          getUserData().role == 'moderator' ||
          (getUserData().keys().hasAny(['tags']) && 
           getUserData().tags.hasAny(['ModÃƒÂ©rateur', 'ModÃƒÂ©rateur Forum']))
        );
    }

    function getChannelData(channelId) {
      return get(/databases/$(database)/documents/forum_channels/$(channelId)).data;
    }

    function getChannelReadRoles(channelData) {
      return channelData.get('readRoles', channelData.get('allowedRoles', channelData.get('allowedTags', ['all'])));
    }

    function getChannelWriteRoles(channelData) {
      return channelData.get('writeRoles', channelData.get('allowedRoles', channelData.get('allowedTags', ['all'])));
    }



    function hasChannelWriteAccess(channelId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          channelId != null &&
          exists(/databases/$(database)/documents/forum_channels/$(channelId)) &&
          getUserData().groupId == getChannelData(channelId).groupId &&
          getChannelData(channelId).get('readOnlyForMembers', false) != true &&
          (
            getChannelWriteRoles(getChannelData(channelId)) == null ||
            getChannelWriteRoles(getChannelData(channelId)).size() == 0 ||
            getChannelWriteRoles(getChannelData(channelId)).hasAny(['all']) ||
            getChannelWriteRoles(getChannelData(channelId)).hasAny([getUserData().get('role', '')]) ||
            (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny(getChannelWriteRoles(getChannelData(channelId))))
          )
        )
      );
    }

    // --- RÃƒË†GLES TÃƒâ€°LÃƒâ€°MÃƒâ€°TRIE & BUGS & HUB ---
    match /hub_system_errors/{errorId} {
      // Ãƒâ€°criture ouverte ÃƒÂ  toutes les apps (Manager, SÃƒÂ©quenceur, Vitrine) avec validation des champs
      allow create: if request.resource.data.keys().hasAll(['appId', 'timestamp']);
      // Lecture et gestion rÃƒÂ©servÃƒÂ©es ÃƒÂ  l'administrateur du Hub
      allow read, update, delete: if isAuthenticated() && (
        (request.auth.token.admin == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('isSystemAdmin', false) == true ||
          getUserData().get('isAdmin', false) == true ||
          getUserData().get('role', '') == 'super-admin'
        ))
      );
    }

    match /hub_telemetry_daily/{eventId} {
      allow create: if request.resource.data.keys().hasAny(['timestamp', 'eventId', 'type']);
      allow read, update, delete: if isAuthenticated() && (
        (request.auth.token.admin == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('isSystemAdmin', false) == true ||
          getUserData().get('isAdmin', false) == true ||
          getUserData().get('role', '') == 'super-admin'
        ))
      );
    }

    match /hub_tickets/{ticketId} {
      allow create: if isAuthenticated(); // Users can create tickets
      allow read, update, delete: if isAuthenticated() && (
        (request.auth.token.admin == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('isSystemAdmin', false) == true ||
          getUserData().get('isAdmin', false) == true ||
          getUserData().get('role', '') == 'super-admin'
        )) ||
        (resource.data.userId == request.auth.uid)
      );
    }

    match /hub_reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        (request.auth.token.admin == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('isSystemAdmin', false) == true ||
          getUserData().get('isAdmin', false) == true ||
          getUserData().get('role', '') == 'super-admin'
        )) ||
        (resource.data.userId == request.auth.uid)
      );
    }

    // Collection Rules

    // Users: Lecture pour tout membre connectÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e au propre profil (sans altÃƒÂ©rer 'role', 'tags', 'isNew', etc.) ou aux Admins/Mestres.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdminOrMestre() || (
          request.auth.uid == userId && (
            (!request.resource.data.keys().hasAny(['isSystemAdmin']) || request.resource.data.isSystemAdmin == false) &&
            (!request.resource.data.keys().hasAny(['hasAccessLogistique']) || request.resource.data.hasAccessLogistique == false) &&
            (!request.resource.data.keys().hasAny(['paymentStatus']) || request.resource.data.paymentStatus == 'unpaid') &&
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'membre') &&
            (!request.resource.data.keys().hasAny(['statutActuel']) || request.resource.data.statutActuel == 'active') &&
            (!request.resource.data.keys().hasAny(['adhesionBase']) || request.resource.data.adhesionBase == false) &&
            (!request.resource.data.keys().hasAny(['selectedOptions']) || request.resource.data.selectedOptions.size() == 0) &&
            (!request.resource.data.keys().hasAny(['tags']) || request.resource.data.tags.size() == 0)
          )
        ) || (
          request.resource.data.isDependent == true &&
          request.resource.data.managedBy == request.auth.uid && (
            (!request.resource.data.keys().hasAny(['isSystemAdmin']) || request.resource.data.isSystemAdmin == false) &&
            (!request.resource.data.keys().hasAny(['hasAccessLogistique']) || request.resource.data.hasAccessLogistique == false) &&
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'membre') &&
            (!request.resource.data.keys().hasAny(['statutActuel']) || request.resource.data.statutActuel == 'active') &&
            (!request.resource.data.keys().hasAny(['tags']) || request.resource.data.tags.size() == 0)
          )
        )
      );
      allow update: if isAuthenticated() && (
        isAdminOrMestre() || (
          request.auth.uid == userId && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'paymentStatus', 'role', 'isSystemAdmin', 'hasAccessLogistique', 'groupId', 'adhesionBase', 'selectedOptions', 'tags', 'statutActuel', 'isNew'
            ])
          )
        ) || (
          resource.data.managedBy == request.auth.uid &&
          resource.data.isDependent == true && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'paymentStatus', 'role', 'isSystemAdmin', 'hasAccessLogistique', 'groupId', 'adhesionBase', 'selectedOptions', 'tags', 'statutActuel', 'managedBy', 'isDependent', 'isNew'
            ])
          )
        )
      );
      allow delete: if isAdminOrMestre() || (
        isAuthenticated() &&
        resource.data.managedBy == request.auth.uid &&
        resource.data.isDependent == true
      );

      // Parcours pÃƒÂ©dagogique : chaque membre gÃƒÂ¨re son propre parcours d'aisance.
      // Les admins/mestres peuvent lire le parcours de tout le monde (suivi pÃƒÂ©dagogique).
      match /parcours/{document=**} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId || isAdminOrMestre()
        );
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // RÃƒÂ©pÃƒÂ©tition espacÃƒÂ©e (historique dÃƒÂ©taillÃƒÂ© des quiz par question)
      match /spaced_repetition/{document=**} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId || isAdminOrMestre()
        );
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Certifications / Examens passÃƒÂ©s
      match /certifications/{document=**} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId || isAdminOrMestre()
        );
        allow write: if isAuthenticated() && (
          request.auth.uid == userId || isAdminOrMestre()
        );
      }
    }

    // Prospects (Inscription publique)
    match /prospects/{prospectId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrMestre();
    }

    // Inventory: Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres et membres avec badge Logistique/Inventaire.
    // Les membres simples peuvent uniquement mettre ÃƒÂ  jour l'ÃƒÂ©tat et faire des demandes d'emprunt (pendingMovement).
    match /inventory/{item} {
      allow read: if isAuthenticated();
      allow create, delete: if canManageInventory();
      allow update: if canManageInventory() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['etat', 'pendingMovement']));
    }

    match /inventoryParts/{item} {
      allow read: if isAuthenticated();
      allow create, delete: if canManageInventory();
      allow update: if canManageInventory() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'pendingMovement']));
    }

    match /inventory_projects/{item} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    match /instrument_models/{item} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    // Associations: Lecture publique (vitrine, marque et thÃƒÂ¨me). Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux administrateurs/mestres ou membres autorisÃƒÂ©s.
    match /associations/{assocId} {
      allow read: if true;
      allow create, delete: if isAdminOrMestre() || hasAnyTag(['Vitrine', 'Webmaster', 'Bureau', 'PrÃ©sident', 'PrÃ©sidente', 'CA']);
      allow update: if (isAdminOrMestre() || hasAnyTag(['Vitrine', 'Webmaster', 'Bureau', 'PrÃ©sident', 'PrÃ©sidente', 'CA'])) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vitrineViews']) && request.resource.data.vitrineViews == resource.data.get('vitrineViews', 0) + 1);

      // RÃƒÂ¨gles d'automatisation
      match /automation_rules/{ruleId} {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      // ParamÃƒÂ¨tres secrets (HelloAsso, Brevo) accessibles uniquement aux admins de l'association
      match /private_settings/credentials {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      // Contacts CRM pour le pÃƒÂ´le diffusion
      match /contacts_diffusion/{contactId} {
        allow read, write: if isAuthenticated() && getUserData().groupId == assocId;
      }

      // Notes pÃƒÂ©dagogiques (Mestre)
      match /blocNotes/{noteId} {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      // MÃƒÂ©tadonnÃƒÂ©es du SÃƒÂ©quenceur (Mestre)
      match /rhythmMetadata/{rhythmId} {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      // Logs des notifications HelloAsso (lecture admin uniquement, ÃƒÂ©criture via Admin SDK / Cloud Function)
      match /helloasso_logs/{logId} {
        allow read: if isAdminOrMestre() && getUserData().groupId == assocId;
        allow write: if false;
      }

      // Membres de l'association (utilisÃƒÂ©s par la gestion O Girador)
      match /members/{memberId} {
        allow read: if isAuthenticated() && getUserData().groupId == assocId;
        allow write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }
    }

    // Packs (catalogue public)
    match /premium_packs/{packId} {
      allow read: if true;
      allow write: if false;
    }

    // Abonnements (Mestre / Manager)
    match /subscriptions/{subscriptionId} {
      allow read: if isAdminOrMestre(); // Seuls les admins peuvent voir l'ÃƒÂ©tat de l'abonnement
      allow write: if false; // GÃƒÂ©rÃƒÂ© uniquement via Firebase Functions / SDK Admin
    }

    // Announcements: Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres.
    match /announcements/{announcement} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Documents / Comptes-Rendus : Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres et membres habilitÃƒÂ©s (badge SecrÃƒÂ©tariat/Studio).
    match /documents/{document} {
      allow read: if isAuthenticated();
      allow update, delete: if canManageDocs();
      allow create: if canManageDocs() || (
        isAuthenticated() && 
        request.resource.data.type == 'report'
      );
    }

    // Reunions (Comptes-rendus) : Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres et membres habilitÃƒÂ©s.
    match /reunions/{reunion} {
      allow read: if isAuthenticated();
      allow write: if canManageDocs();
    }

    // Inventory (Instruments, Equipment): Lecture si authentifié. Écriture réservée aux admins/mestres et badge Logistique.
    match /inventory/{item} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    match /inventory_parts/{part} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    // Wardrobe Inventory: Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres et badge Logistique/Costumes.
    match /wardrobeInventory/{item} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    // Costumes & PiÃƒÂ¨ces: Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres et badge Logistique/Costumes.
    match /costumes/{costume} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    // Couture Projects: Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres et badge Logistique/Costumes.
    match /coutureProjects/{project} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    // Formations et chorÃƒÂ©graphies (Danse / SÃƒÂ©quenceur)
    match /audio_masters/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /choreographies/{choreo} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }
    match /formations_catalogue/{formation} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }
    match /patterns/{pattern} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }
    match /sections/{section} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }
    // Presets (SÃƒÂ©quences complÃƒÂ¨tes / Projets du SÃƒÂ©quenceur)
    match /presets/{preset} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        exists(/databases/$(database)/documents/associations/$(getUserData().groupId)) &&
        (
          get(/databases/$(database)/documents/associations/$(getUserData().groupId)).data.unlockedPacks.hasAny(['sequenceur', 'createur', 'gestion', 'integrale', 'sequenceur-solo']) ||
          get(/databases/$(database)/documents/associations/$(getUserData().groupId)).data.appAccess.sequenceur == true
        )
      );
    }
    match /steps/{step} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Agenda Templates
    match /agendaTemplates/{tpl} {
      allow read: if isAuthenticated();
      allow write: if canManageEvents();
    }

    // Rhythms: Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres, ou membres avec accÃƒÂ¨s SÃƒÂ©quenciador.
    match /rhythms/{rhythm} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        exists(/databases/$(database)/documents/associations/$(getUserData().groupId)) &&
        (
          get(/databases/$(database)/documents/associations/$(getUserData().groupId)).data.unlockedPacks.hasAny(['sequenceur', 'createur', 'gestion', 'integrale', 'sequenceur-solo']) ||
          get(/databases/$(database)/documents/associations/$(getUserData().groupId)).data.appAccess.sequenceur == true
        )
      );
    }

    // Signaux du MaÃƒÂ®tre: Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres.
    match /mestre_signals/{signal} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Workshops: Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres.
    match /workshops/{workshop} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Notifications queue: CrÃƒÂ©ation si authentifiÃƒÂ©. Lecture/Ãƒâ€°criture pour admins/mestres.
    match /notifications_queue/{notif} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdminOrMestre();
    }

    // Campaigns: Lecture si authentifiÃƒÂ©. Ãƒâ€°criture rÃƒÂ©servÃƒÂ©e aux admins/mestres.
    match /campaigns/{campaign} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Events: Lecture si authentifiÃƒÂ© ou si isPublic == true. CrÃƒÂ©ation/Suppression/Modif globale rÃƒÂ©servÃƒÂ©e aux admins/mestres ou badge Agenda.
    // Seule la mise ÃƒÂ  jour du tableau inscriptions (RSVP) est autorisÃƒÂ©e aux membres simples sur leur participation.
    match /events/{event} {
      allow read: if isAuthenticated() || (resource != null && resource.data.isPublic == true);
      allow create, delete: if canManageEvents();
      allow update: if isAuthenticated() && (
        canManageEvents() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inscriptions', 'invitesExternes', 'volunteerShifts', 'suggestionsOrdreDuJour', 'compteRenduApprovals', 'votes', 'covoiturage', 'compteRenduStatus', 'compteRenduVaralId']))
      );

      // Sous-collection des commentaires et questions logistiques de l'ÃƒÂ©vÃƒÂ©nement
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.auteurId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (
          resource.data.auteurId == request.auth.uid ||
          canManageEvents() ||
          isModerator()
        );
      }
    }

    // Transactions (TrÃƒÂ©sorerie) : Interdites d'ÃƒÂ©criture aux membres simples sans badge TrÃƒÂ©sorerie
    match /transactions/{transaction} {
      allow read, write: if (canManageTreasury() || isAdminOrMestre()) && (
        resource == null || getUserData().groupId == resource.data.groupId
      );
    }

    // Forum Channels: Lecture si membre autorisÃƒÂ© par rÃƒÂ´le/tag/transparence, ÃƒÂ©criture rÃƒÂ©servÃƒÂ©e aux admins/crÃƒÂ©ateurs de groupe
    match /forum_channels/{channelId} {
      allow read: if isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        isAdminOrMestre() ||
        (
          getUserData().groupId == resource.data.groupId &&
          (
            resource.data.get('isTransparent', false) == true ||
            getChannelReadRoles(resource.data) == null ||
            getChannelReadRoles(resource.data).size() == 0 ||
            getChannelReadRoles(resource.data).hasAny(['all']) ||
            getChannelReadRoles(resource.data).hasAny([getUserData().get('role', '')]) ||
            (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny(getChannelReadRoles(resource.data)))
          )
        )
      );
      allow create: if isAuthenticated() && request.resource.data.groupId == getUserData().groupId;
      allow update, delete: if isAdminOrMestre();
    }

    // Forum Threads: La lecture est autorisÃƒÂ©e pour tout le groupe (le filtrage par salon/badge se fait cÃƒÂ´tÃƒÂ© client)
    // pour ÃƒÂ©viter les limites de quota get() de Firestore lors des requÃƒÂªtes.
    match /forum/{thread} {
      allow read: if isAuthenticated() && resource.data.groupId == getUserData().groupId;
      allow create: if isAuthenticated() && (
        hasChannelWriteAccess(request.resource.data.get('channelId', null))
      );
      allow update: if isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          resource.data.authorId == request.auth.uid &&
          (hasChannelWriteAccess(resource.data.get('channelId', null)) || !resource.data.keys().hasAny(['channelId'])) &&
          (!request.resource.data.keys().hasAny(['channelId']) || request.resource.data.channelId == resource.data.get('channelId', null))
        ) ||
        (
          hasChannelWriteAccess(resource.data.get('channelId', null)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponses', 'derniereModification', 'poll'])
        )
      );
      allow delete: if isAdminOrMestre() || isModerator() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    match /forum_posts/{post} {
      allow read: if isAuthenticated() && resource.data.groupId == getUserData().groupId;
      allow create: if isAuthenticated() && (
        hasChannelWriteAccess(request.resource.data.get('channelId', null))
      );
      allow update: if isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          resource.data.authorId == request.auth.uid &&
          (hasChannelWriteAccess(resource.data.get('channelId', null)) || !resource.data.keys().hasAny(['channelId'])) &&
          (!request.resource.data.keys().hasAny(['channelId']) || request.resource.data.channelId == resource.data.get('channelId', null))
        ) ||
        (
          hasChannelWriteAccess(resource.data.get('channelId', null)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponses', 'derniereModification', 'poll'])
        )
      );
      allow delete: if isAdminOrMestre() || isModerator() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Campaign Requests (Commandes d'articles) : CrÃƒÂ©ation et modification restreintes au demandeur propriÃƒÂ©taire ou aux admins
    match /campaignRequests/{req} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || canManageInventory()
      );
    }

    // Messages privÃƒÂ©s: Restreints ÃƒÂ  l'expÃƒÂ©diteur et au destinataire
    match /private_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid &&
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
      );
      allow delete: if false;
    }

    // Factures & Devis : Lecture et ÃƒÂ©criture rÃƒÂ©servÃƒÂ©es aux membres habilitÃƒÂ©s TrÃƒÂ©sorerie / Admin
    match /invoices/{invoice} {
      allow read: if isAuthenticated();
      allow write: if canManageTreasury();
    }

    // Pipeline Prestations (PÃƒÂ´le Diffusion) : Lecture et ÃƒÂ©criture rÃƒÂ©servÃƒÂ©es aux membres habilitÃƒÂ©s Diffusion / Admin
    match /gigs_pipeline/{gig} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre() || hasAnyTag(['Diffusion', 'Booking', 'Bureau', 'CA', 'Communication']);
    }

    // Pending payments: RÃƒÂ©servÃƒÂ© aux admins et mestres
    match /pending_payments/{email} {
      allow read, write: if isAdminOrMestre();
    }

    // Newsletter subscribers: Inscription publique autorisÃƒÂ©e (create), lecture/export rÃƒÂ©servÃƒÂ©s aux admins/mestres
    match /newsletter_subscribers/{subscriberDoc} {
      allow create: if request.resource.data.keys().hasAll(['email']);
      allow read, update, delete: if isAdminOrMestre();
    }

    // QR Code Sessions (WhatsApp Web login) : CrÃƒÂ©ation et ÃƒÂ©coute temps rÃƒÂ©el autorisÃƒÂ©es,
    // mise ÃƒÂ  jour directe interdite (mise ÃƒÂ  jour rÃƒÂ©servÃƒÂ©e aux Cloud Functions / Admin SDK).
    match /qr_sessions/{sessionId} {
      allow create: if true;
      allow read: if true;
      allow delete: if isAuthenticated();
      allow update: if false;
    }
  }
}

