rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSystemAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['isSystemAdmin']) && request.auth.token.isSystemAdmin == true) ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().get('isSystemAdmin', false) == true)
      );
    }

    // Vérifie strictement que le document appartient au même groupe que l'utilisateur demandeur
    function isDocSameGroup() {
      return isSystemAdmin() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource == null ? (
            !request.resource.data.keys().hasAny(['groupId']) || 
            request.resource.data.groupId == getUserData().get('groupId', '')
          ) : (
            !resource.data.keys().hasAny(['groupId']) || 
            resource.data.groupId == getUserData().get('groupId', '')
          )
        )
      );
    }

    // Règle de lecture stricte cloisonnée par organisation (SaaS Multi-Tenants)
    function canReadGroupData() {
      return isAuthenticated() && (
        isSystemAdmin() || 
        resource == null || 
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          resource.data.get('groupId', '') == getUserData().get('groupId', '')
        )
      );
    }

    function isAdminOrMestre() {
      return isAuthenticated() && (
        isSystemAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            getUserData().role in ['mestre', 'Mestre', 'super-admin', 'Super-admin', 'admin', 'Admin', 'bureau', 'Bureau', 'ca', 'CA'] ||
            (getUserData().keys().hasAny(['hasAccessLogistique']) && getUserData().hasAccessLogistique == true) ||
            (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny([
              'Bureau', 'Président', 'Présidente', 'Présidence', 'CA', 'C.A', 'Direction', 'Admin', 'Modérateur', 'Mestre', 'Logistique', 'Logisticien'
            ]))
          ) && (
            resource == null ? 
              (!request.resource.data.keys().hasAny(['groupId']) || request.resource.data.groupId == getUserData().groupId) :
              (!resource.data.keys().hasAny(['groupId']) || resource.data.groupId == getUserData().groupId)
          )
        )
      );
    }

    function hasAnyTag(tagList) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().keys().hasAny(['tags']) &&
        getUserData().tags.hasAny(tagList);
    }

    // Checks if the authenticated user belongs to the same mestre group as the document.
    // Used by sequencer collections to allow group members (élèves) to read/write.
    function isSameGroup(docMestreId) {
      return isAuthenticated() &&
        docMestreId != null &&
        docMestreId != '' &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().get('mestreId', '') == docMestreId;
    }

    function canManageEvents() {
      return isDocSameGroup() && (isAdminOrMestre() || hasAnyTag([
        'Agenda', 'Agenda & Événements', 'Agenda & Evenements', 'Bureau', 'Président', 'President', 'Présidente', 'Presidente', 'CA', 'Direction', 'Admin'
      ]));
    }

    function canManageInventory() {
      return isDocSameGroup() && (isAdminOrMestre() || 
        (getUserData().keys().hasAny(['hasAccessLogistique']) && getUserData().hasAccessLogistique == true) ||
        hasAnyTag([
          'Inventaire', 'Logistique', 'logistique', 'Logisticien', 'Logisticienne',
          'Matériel', 'Materiel', 'matériel', 'materiel', 'Instruments', 'Commandes',
          'Bureau', 'CA', 'C.A', 'Direction', 'Atelier', 'Lutherie', 'Costumerie'
        ]));
    }

    function canManageTreasury() {
      return isDocSameGroup() && (isAdminOrMestre() || hasAnyTag([
        'Trésorerie', 'Tresorerie', 'Trésorier', 'Tresorier', 'Trésorière', 'Tresoriere', 'Comptable', 'Finance', 'Bureau', 'CA', 'Direction'
      ]));
    }

    function canManageDocs() {
      return isDocSameGroup() && (isAdminOrMestre() || hasAnyTag([
        'Secrétariat', 'Secretariat', 'Comptes-Rendus', 'Studio', 'Communication', 'Bureau', 'CA', 'Direction'
      ]));
    }

    function canManageRepertoire() {
      return isAuthenticated() && (
        isAdminOrMestre() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('role', '') in ['mestre', 'Mestre', 'admin', 'Admin', 'super-admin', 'Super-admin'] ||
          getUserData().get('isSystemAdmin', false) == true
        )) ||
        (request.auth.token != null && (
          request.auth.token.get('admin', false) == true ||
          request.auth.token.get('role', '') in ['mestre', 'admin', 'super-admin']
        ))
      );
    }

    function isModerator() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().role == 'mestre' || 
          getUserData().role == 'Mestre' || 
          getUserData().role == 'super-admin' || 
          getUserData().role == 'Super-admin' || 
          getUserData().role == 'admin' || 
          getUserData().role == 'Admin' || 
          getUserData().role == 'bureau' || 
          getUserData().role == 'Bureau' || 
          getUserData().isSystemAdmin == true ||
          getUserData().role == 'moderator' ||
          (getUserData().keys().hasAny(['tags']) && 
           getUserData().tags.hasAny(['Modérateur', 'Moderateur', 'Modérateur Forum', 'Bureau', 'Président', 'President', 'Présidente', 'Presidente', 'CA', 'Admin']))
        );
    }

    function getChannelData(channelId) {
      return get(/databases/$(database)/documents/forum_channels/$(channelId)).data;
    }

    function hasChannelReadAccess(channelId) {
      return isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          channelId != null &&
          exists(/databases/$(database)/documents/forum_channels/$(channelId)) &&
          getUserData().groupId == getChannelData(channelId).groupId &&
          (
            getChannelData(channelId).isTransparent == true ||
            getChannelData(channelId).readRoles == null ||
            getChannelData(channelId).readRoles.size() == 0 ||
            getChannelData(channelId).readRoles.hasAny(['all']) ||
            (getChannelData(channelId).keys().hasAny(['allowedRoles']) && getChannelData(channelId).allowedRoles.hasAny(['all'])) ||
            getChannelData(channelId).readRoles.hasAny([getUserData().role]) ||
            (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny(getChannelData(channelId).readRoles))
          )
        )
      );
    }

    function hasChannelWriteAccess(channelId) {
      return isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          channelId != null &&
          exists(/databases/$(database)/documents/forum_channels/$(channelId)) &&
          getUserData().groupId == getChannelData(channelId).groupId &&
          (!getChannelData(channelId).keys().hasAny(['readOnlyForMembers']) || getChannelData(channelId).readOnlyForMembers != true) &&
          (
            getChannelData(channelId).writeRoles == null ||
            getChannelData(channelId).writeRoles.size() == 0 ||
            getChannelData(channelId).writeRoles.hasAny(['all']) ||
            (getChannelData(channelId).keys().hasAny(['allowedRoles']) && getChannelData(channelId).allowedRoles.hasAny(['all'])) ||
            getChannelData(channelId).writeRoles.hasAny([getUserData().role]) ||
            (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny(getChannelData(channelId).writeRoles))
          )
        )
      );
    }

    // --- RÃˆGLES TÃ‰LÃ‰MÃ‰TRIE & BUGS ---
    match /hub_system_errors/{errorId} {
      allow create: if request.resource.data.keys().hasAll(['appId', 'timestamp', 'errorMessage']);
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /hub_telemetry_daily/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['appId', 'timestamp', 'eventName']);
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Collection Rules

    match /settings/{document} {
      allow read: if canReadGroupData();
      allow write: if isAdminOrMestre();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSystemAdmin() ||
        (resource != null && resource.data.get('managedBy', '') == request.auth.uid) ||
        (
          resource != null &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          resource.data.get('groupId', '') == getUserData().get('groupId', '')
        )
      );
      allow create: if isAuthenticated() && (
        isAdminOrMestre() || (
          request.auth.uid == userId && (
            (!request.resource.data.keys().hasAny(['isSystemAdmin']) || request.resource.data.isSystemAdmin == false) &&
            (!request.resource.data.keys().hasAny(['hasAccessLogistique']) || request.resource.data.hasAccessLogistique == false) &&
            (!request.resource.data.keys().hasAny(['paymentStatus']) || request.resource.data.paymentStatus == 'unpaid') &&
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'membre' || request.resource.data.role == 'visiteur' || request.resource.data.role == 'eleve' || (request.resource.data.role == 'mestre' && request.auth.token.email.matches(".*@ogirador\\.com"))) &&
            (!request.resource.data.keys().hasAny(['statutActuel']) || request.resource.data.statutActuel == 'active') &&
            (!request.resource.data.keys().hasAny(['adhesionBase']) || request.resource.data.adhesionBase == true) &&
            (!request.resource.data.keys().hasAny(['canWriteSequenciador']) || request.resource.data.canWriteSequenciador == false) &&
            (!request.resource.data.keys().hasAny(['canWriteDansador']) || request.resource.data.canWriteDansador == false) &&
            (!request.resource.data.keys().hasAny(['canWriteOrchestrador']) || request.resource.data.canWriteOrchestrador == false) &&
            (!request.resource.data.keys().hasAny(['selectedOptions']) || request.resource.data.selectedOptions.size() == 0) &&
            (!request.resource.data.keys().hasAny(['tags']) || request.resource.data.tags.size() == 0)
          )
        ) || (
          request.resource.data.isDependent == true &&
          request.resource.data.managedBy == request.auth.uid && (
            (!request.resource.data.keys().hasAny(['isSystemAdmin']) || request.resource.data.isSystemAdmin == false) &&
            (!request.resource.data.keys().hasAny(['hasAccessLogistique']) || request.resource.data.hasAccessLogistique == false) &&
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'membre' || request.resource.data.role == 'visiteur' || request.resource.data.role == 'eleve') &&
            (!request.resource.data.keys().hasAny(['statutActuel']) || request.resource.data.statutActuel == 'active') &&
            (!request.resource.data.keys().hasAny(['tags']) || request.resource.data.tags.size() == 0)
          )
        )
      );
      allow update: if isAuthenticated() && (
        isAdminOrMestre() || (
          request.auth.uid == userId && (
            (
              resource.data.get('onboardingCompleted', false) == false &&
              (!request.resource.data.keys().hasAny(['isSystemAdmin']) || request.resource.data.isSystemAdmin == false) &&
              (!request.resource.data.keys().hasAny(['hasAccessLogistique']) || request.resource.data.hasAccessLogistique == false) &&
              (!request.resource.data.keys().hasAny(['paymentStatus']) || request.resource.data.paymentStatus == 'unpaid') &&
              (!request.resource.data.keys().hasAny(['canWriteSequenciador']) || request.resource.data.canWriteSequenciador == false) &&
              (!request.resource.data.keys().hasAny(['canWriteDansador']) || request.resource.data.canWriteDansador == false) &&
              (!request.resource.data.keys().hasAny(['canWriteOrchestrador']) || request.resource.data.canWriteOrchestrador == false) &&
              (!request.resource.data.keys().hasAny(['tags']) || request.resource.data.tags.size() == 0) &&
              (!request.resource.data.keys().hasAny(['statutActuel']) || request.resource.data.statutActuel == 'active')
            ) || (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'paymentStatus', 'role', 'isSystemAdmin', 'hasAccessLogistique', 'groupId', 'adhesionBase', 'selectedOptions', 'tags', 'statutActuel', 'isNew',
                'canWriteSequenciador', 'canWriteDansador', 'canWriteOrchestrador'
              ])
            )
          )
        ) || (
          resource.data.managedBy == request.auth.uid &&
          resource.data.isDependent == true && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'paymentStatus', 'role', 'isSystemAdmin', 'hasAccessLogistique', 'groupId', 'adhesionBase', 'selectedOptions', 'tags', 'statutActuel', 'managedBy', 'isDependent', 'isNew',
              'canWriteSequenciador', 'canWriteDansador', 'canWriteOrchestrador'
            ])
          )
        )
      );
      allow delete: if isAdminOrMestre() || (
        isAuthenticated() &&
        resource.data.managedBy == request.auth.uid &&
        resource.data.isDependent == true
      );

      // Sous-collection parcours (auto-évaluations et demandes de révision de l'élève)
      match /parcours/{parcoursId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          isSystemAdmin() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            getUserData().get('groupId', '') == get(/databases/$(database)/documents/users/$(userId)).data.get('groupId', '')
          )
        );
        allow write: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdminOrMestre() ||
          (resource != null && resource.data.managedBy == request.auth.uid)
        );
      }

      // Sous-collection spaced_repetition (mémorisation espacée / révisions du jour de l'élève)
      match /spaced_repetition/{srId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          isSystemAdmin() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            getUserData().get('groupId', '') == get(/databases/$(database)/documents/users/$(userId)).data.get('groupId', '')
          )
        );
        allow write: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdminOrMestre() ||
          (resource != null && resource.data.managedBy == request.auth.uid)
        );
      }

      // Sous-collection certifications (examens et diplômes de l'élève)
      match /certifications/{certId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          isSystemAdmin() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            getUserData().get('groupId', '') == get(/databases/$(database)/documents/users/$(userId)).data.get('groupId', '')
          )
        );
        allow write: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdminOrMestre() ||
          (resource != null && resource.data.managedBy == request.auth.uid)
        );
      }
    }

    match /inventory/{item} {
      allow read: if canReadGroupData();
      allow write: if canManageInventory();
    }

    match /inventory_supplies/{item} {
      allow read: if canReadGroupData();
      allow write: if canManageInventory();
    }

    match /workshop_tools/{item} {
      allow read: if canReadGroupData();
      allow write: if canManageInventory();
    }

    match /inventory_parts/{item} {
      allow read: if canReadGroupData();
      allow write: if canManageInventory();
    }

    match /inventoryParts/{item} {
      allow read: if canReadGroupData();
      allow write: if canManageInventory();
    }

    match /inventory_projects/{item} {
      allow read: if canReadGroupData();
      allow write: if canManageInventory();
    }

    match /agendaTemplates/{item} {
      allow read: if canReadGroupData();
      allow write: if canManageEvents();
    }

    match /associations/{assocId} {
      allow read: if true;
      allow create, delete: if isAdminOrMestre() || hasAnyTag(['Vitrine', 'Webmaster', 'Bureau', 'Président', 'President', 'Présidente', 'Presidente', 'CA']);
      allow update: if isAdminOrMestre() || hasAnyTag(['Vitrine', 'Webmaster', 'Bureau', 'Président', 'President', 'Présidente', 'Presidente', 'CA']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vitrineViews']);

      match /private_settings/credentials {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      match /contacts_diffusion/{contactId} {
        allow read, write: if isAuthenticated() && getUserData().groupId == assocId;
      }

      match /blocNotes/{noteId} {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      match /rhythmMetadata/{rhythmId} {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      // Classeur central du répertoire de la troupe (morceaux de la saison, chantiers, archives)
      match /repertoire/{pieceId} {
        allow read: if isAuthenticated() && (isSystemAdmin() || getUserData().groupId == assocId);
        allow write: if (isSystemAdmin() || getUserData().groupId == assocId) && canManageRepertoire();
      }

      // Règles d'automatisation et de relances d'agenda de l'association
      match /automation_rules/{ruleId} {
        allow read: if isAuthenticated() && (getUserData().groupId == assocId || isAdminOrMestre());
        allow write: if isAuthenticated() && (isAdminOrMestre() || canManageEvents()) && (getUserData().groupId == assocId || request.auth.token.isSystemAdmin == true);
      }

      // Traçabilité et historique des notifications de paiement HelloAsso
      match /helloasso_logs/{logId} {
        allow read: if isAdminOrMestre() && getUserData().groupId == assocId;
      }
    }

    // Collection racine automation_rules (rétrocompatibilité)
    match /automation_rules/{ruleId} {
      allow read: if isAuthenticated() && (resource == null || getUserData().groupId == resource.data.groupId || isAdminOrMestre());
      allow write: if isAuthenticated() && (isAdminOrMestre() || canManageEvents());
    }

    match /announcements/{announcement} {
      allow read: if canReadGroupData();
      allow write: if isAdminOrMestre();
    }

    match /documents/{document} {
      allow read: if canReadGroupData();
      allow write: if canManageDocs();
    }

    match /reunions/{reunion} {
      allow read: if canReadGroupData();
      allow write: if canManageDocs();
    }

    match /wardrobeInventory/{item} {
      allow read: if canReadGroupData();
      allow write: if canManageInventory();
    }

    match /costumes/{costume} {
      allow read: if canReadGroupData();
      allow write: if canManageInventory();
    }

    match /coutureProjects/{project} {
      allow read: if canReadGroupData();
      allow write: if canManageInventory();
    }

    match /rhythms/{rhythm} {
      allow read: if canReadGroupData();
      allow write: if isAdminOrMestre();
    }

    match /workshops/{workshop} {
      allow read: if canReadGroupData();
      allow write: if isAdminOrMestre();
    }

    match /notifications_queue/{notif} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdminOrMestre();
    }

    match /campaigns/{campaign} {
      allow read: if canReadGroupData();
      allow write: if isAdminOrMestre() || canManageInventory();
    }

    match /events/{event} {
      allow read: if (resource != null && resource.data.get('isPublic', false) == true) || canReadGroupData();
      allow create, delete: if canManageEvents();
      allow update: if isAuthenticated() && (
        canManageEvents() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inscriptions', 'invitesExternes']))
      );

      match /comments/{commentId} {
        allow read: if canReadGroupData();
        allow create: if isAuthenticated() && request.resource.data.auteurId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (
          resource.data.auteurId == request.auth.uid ||
          canManageEvents() ||
          isModerator()
        );
      }
    }

    match /transactions/{transaction} {
      allow read, write: if (canManageTreasury() || isAdminOrMestre()) && (
        resource == null || getUserData().groupId == resource.data.groupId
      );
    }

    match /forum_channels/{channelId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        isAdminOrMestre() ||
        (
          resource != null &&
          getUserData().get('groupId', '') == resource.data.get('groupId', '') &&
          (
            resource.data.get('isTransparent', false) == true ||
            !resource.data.keys().hasAny(['readRoles']) ||
            resource.data.readRoles == null ||
            resource.data.readRoles.size() == 0 ||
            resource.data.readRoles.hasAny(['all']) ||
            (resource.data.keys().hasAny(['allowedRoles']) && resource.data.allowedRoles.hasAny(['all'])) ||
            (resource.data.keys().hasAny(['allowedRoles']) && resource.data.allowedRoles.hasAny([getUserData().role])) ||
            resource.data.readRoles.hasAny([getUserData().role]) ||
            (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny(resource.data.readRoles)) ||
            request.auth != null
          )
        )
      );
      allow create: if isAuthenticated() && request.resource.data.get('groupId', '') == getUserData().get('groupId', '');
      allow update, delete: if isAdminOrMestre();
    }

    match /forum/{thread} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        isAdminOrMestre() ||
        isModerator() ||
        (resource != null && resource.data.get('groupId', '') == getUserData().get('groupId', '')) ||
        (resource != null && resource.data.keys().hasAny(['channelId']) && hasChannelReadAccess(resource.data.channelId))
      );
      allow create: if isAuthenticated() && (
        hasChannelWriteAccess(request.resource.data.channelId)
      );
      allow update: if isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          resource.data.authorId == request.auth.uid &&
          (hasChannelWriteAccess(resource.data.channelId) || !resource.data.keys().hasAny(['channelId'])) &&
          (!request.resource.data.keys().hasAny(['channelId']) || request.resource.data.channelId == resource.data.channelId)
        ) ||
        (
          hasChannelWriteAccess(resource.data.channelId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponses', 'derniereModification', 'poll'])
        )
      );
      allow delete: if isAdminOrMestre() || isModerator() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    match /campaignRequests/{req} {
      allow read: if canReadGroupData();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || canManageInventory()
      );
    }

    match /private_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid &&
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
      );
      allow delete: if false;
    }

    // Gestion des conversations privées (échanges 1-à-1 et boucles de discussion multi-membres)
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        (resource != null && request.auth.uid in resource.data.participantIds) || 
        isAdminOrMestre()
      );
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participantIds &&
        (
          !request.resource.data.keys().hasAny(['groupId']) ||
          request.resource.data.groupId == getUserData().get('groupId', '') ||
          isSystemAdmin()
        );
      allow update: if isAuthenticated() && (
        // 1. Modification des métadonnées (titre, participants) restreinte aux admins du groupe ou admins de l'association
        (
          request.auth.uid in resource.data.get('adminIds', [resource.data.createdBy]) || 
          isAdminOrMestre()
        ) ||
        // 2. Mise à jour des activités de discussion (dernier message, statut de lecture, date de mise à jour) par un participant
        (
          request.auth.uid in resource.data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['readStatus', 'lastMessage', 'updatedAt'])
        ) ||
        // 3. Un participant qui quitte volontairement la boucle de discussion
        (
          request.auth.uid in resource.data.participantIds &&
          !(request.auth.uid in request.resource.data.participantIds)
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid || 
        isAdminOrMestre()
      );
    }

    // Messages échangés au sein d'une conversation (directe ou groupe)
    match /conversation_messages/{messageId} {
      allow read: if isAuthenticated() && (
        (resource != null && request.auth.uid in resource.data.participantIds) || 
        isAdminOrMestre()
      );
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && (
        // Permettre l'ajout ou le retrait de réactions emojis par les participants
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        isAdminOrMestre()
      );
    }

    match /invoices/{invoice} {
      allow read: if canReadGroupData();
      allow write: if canManageTreasury();
    }

    match /gigs_pipeline/{gig} {
      allow read: if canReadGroupData();
      allow write: if isAdminOrMestre() || hasAnyTag(['Diffusion', 'Booking', 'Bureau', 'CA', 'Communication']);
    }

    match /pending_payments/{email} {
      allow read, write: if isAdminOrMestre();
    }

    match /newsletter_subscribers/{subscriberDoc} {
      allow create: if true;
      allow read, update, delete: if isAdminOrMestre();
    }

    match /qr_sessions/{sessionId} {
      allow create: if true;
      allow read: if true;
      allow delete: if isAuthenticated();
      allow update: if false;
    }

    match /audio_masters/{document} {
      allow read: if request.auth != null; 
      allow write: if isAdminOrMestre(); 
    }

    match /formations_catalogue/{document} {
      allow read: if request.auth != null; 
      allow write: if isAdminOrMestre(); 
    }

    match /choreographies/{document} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.get('tenantId', '') == getUserData().get('groupId', '') ||
        resource.data.get('groupId', '') == getUserData().get('groupId', '')
      );
      allow write: if (isAdminOrMestre() || (getUserData().keys().hasAny(['canWriteDansador']) && getUserData().canWriteDansador == true)) && (resource == null || getUserData().groupId == resource.data.get('tenantId', resource.data.get('groupId', '')) || getUserData().groupId == request.resource.data.get('tenantId', request.resource.data.get('groupId', '')));
    }

    match /steps/{document} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.get('tenantId', '') == getUserData().get('groupId', '') ||
        resource.data.get('groupId', '') == getUserData().get('groupId', '')
      );
      allow write: if (isAdminOrMestre() || (getUserData().keys().hasAny(['canWriteDansador']) && getUserData().canWriteDansador == true)) && (resource == null || getUserData().groupId == resource.data.get('tenantId', resource.data.get('groupId', '')) || getUserData().groupId == request.resource.data.get('tenantId', request.resource.data.get('groupId', '')));
    }

    match /programs/{document} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.get('tenantId', '') == getUserData().get('groupId', '') ||
        resource.data.get('groupId', '') == getUserData().get('groupId', '')
      );
      allow write: if (isAdminOrMestre() || (getUserData().keys().hasAny(['canWriteDansador']) && getUserData().canWriteDansador == true)) && (resource == null || getUserData().groupId == resource.data.get('tenantId', resource.data.get('groupId', '')) || getUserData().groupId == request.resource.data.get('tenantId', request.resource.data.get('groupId', '')));
    }

    // --- O GIRADOR: SÉQUENCEUR ---
    // Group members (élèves with same mestreId) can read/write alongside the mestre.
    match /patterns/{patternId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && (isAdminOrMestre()
                        || request.auth.uid == request.resource.data.ownerId 
                        || request.auth.uid == request.resource.data.get('mestreId', '')
                        || isSameGroup(request.resource.data.get('mestreId', '')));
      allow update, delete: if request.auth != null 
                            && (isAdminOrMestre()
                                || request.auth.uid == resource.data.ownerId 
                                || request.auth.uid == resource.data.get('mestreId', '')
                                || isSameGroup(resource.data.get('mestreId', '')));
    }
    match /sections/{sectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && (isAdminOrMestre()
                        || request.auth.uid == request.resource.data.ownerId 
                        || request.auth.uid == request.resource.data.get('mestreId', '')
                        || isSameGroup(request.resource.data.get('mestreId', '')));
      allow update, delete: if request.auth != null 
                            && (isAdminOrMestre()
                                || request.auth.uid == resource.data.ownerId 
                                || request.auth.uid == resource.data.get('mestreId', '')
                                || isSameGroup(resource.data.get('mestreId', '')));
    }
    match /presets/{presetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && (isAdminOrMestre()
                        || request.auth.uid == request.resource.data.ownerId 
                        || request.auth.uid == request.resource.data.get('mestreId', '')
                        || isSameGroup(request.resource.data.get('mestreId', '')));
      allow update, delete: if request.auth != null 
                            && (isAdminOrMestre()
                                || request.auth.uid == resource.data.ownerId 
                                || request.auth.uid == resource.data.get('mestreId', '')
                                || isSameGroup(resource.data.get('mestreId', '')));
    }
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && (isAdminOrMestre()
                        || request.auth.uid == request.resource.data.ownerId 
                        || request.auth.uid == request.resource.data.get('mestreId', '')
                        || isSameGroup(request.resource.data.get('mestreId', '')));
      allow update, delete: if request.auth != null 
                            && (isAdminOrMestre()
                                || request.auth.uid == resource.data.ownerId 
                                || request.auth.uid == resource.data.get('mestreId', '')
                                || isSameGroup(resource.data.get('mestreId', '')));
    }
    match /progressions/{progressionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null 
                            && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.mestreId);
    }
    match /mestre_signals/{signalId} {
      allow read: if true;
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.mestreId || (getUserData().keys().hasAny(['canWriteSequenciador']) && getUserData().canWriteSequenciador == true));
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.mestreId || (getUserData().keys().hasAny(['canWriteSequenciador']) && getUserData().canWriteSequenciador == true));
    }
    match /varals/{varalId} {
      allow read: if true;
      allow write: if isAdminOrMestre();
    }
    match /hub_telemetry_daily/{docId} {
      allow read: if isAdminOrMestre();
      allow create: if true;
      allow update, delete: if isAdminOrMestre();
    }
    match /hub_reviews/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /premium_packs/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrMestre();
    }
    match /instrument_models/{item} {
      allow read: if canReadGroupData();
      allow write: if isAdminOrMestre() || canManageInventory();
    }
    
  }
}

