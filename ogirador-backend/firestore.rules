rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOrMestre() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().role == 'mestre' || 
          getUserData().role == 'super-admin' || 
          getUserData().role == 'admin' ||
          getUserData().role == 'bureau' ||
          getUserData().role == 'ca' ||
          getUserData().isSystemAdmin == true ||
          (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny([
            'Bureau', 'Président', 'Présidente', 'Présidence', 'CA', 'Direction', 'Admin'
          ]))
        );
    }

    function hasAnyTag(tagList) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().keys().hasAny(['tags']) &&
        getUserData().tags.hasAny(tagList);
    }

    function canManageEvents() {
      return isAdminOrMestre() || hasAnyTag([
        'Agenda', 'Agenda & Événements', 'Bureau', 'Président', 'Présidente', 'CA', 'Direction', 'Admin'
      ]);
    }

    function canManageInventory() {
      return isAdminOrMestre() || hasAnyTag([
        'Inventaire', 'Logistique', 'Matériel', 'Instruments', 'Commandes', 'Bureau', 'CA', 'Direction'
      ]);
    }

    function canManageTreasury() {
      return isAdminOrMestre() || hasAnyTag([
        'Trésorerie', 'Trésorier', 'Trésorière', 'Comptable', 'Finance', 'Bureau', 'CA', 'Direction'
      ]);
    }

    function canManageDocs() {
      return isAdminOrMestre() || hasAnyTag([
        'Secrétariat', 'Comptes-Rendus', 'Studio', 'Communication', 'Bureau', 'CA', 'Direction'
      ]);
    }

    function isModerator() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().role == 'mestre' || 
          getUserData().role == 'super-admin' || 
          getUserData().isSystemAdmin == true ||
          getUserData().role == 'moderator' ||
          (getUserData().keys().hasAny(['tags']) && 
           getUserData().tags.hasAny(['Modérateur', 'Modérateur Forum']))
        );
    }

    function getChannelData(channelId) {
      return get(/databases/$(database)/documents/forum_channels/$(channelId)).data;
    }

    function hasChannelReadAccess(channelId) {
      return isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          channelId != null &&
          exists(/databases/$(database)/documents/forum_channels/$(channelId)) &&
          getUserData().groupId == getChannelData(channelId).groupId &&
          (
            getChannelData(channelId).isTransparent == true ||
            getChannelData(channelId).readRoles == null ||
            getChannelData(channelId).readRoles.size() == 0 ||
            getChannelData(channelId).readRoles.hasAny(['all']) ||
            (getChannelData(channelId).keys().hasAny(['allowedRoles']) && getChannelData(channelId).allowedRoles.hasAny(['all'])) ||
            getChannelData(channelId).readRoles.hasAny([getUserData().role]) ||
            (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny(getChannelData(channelId).readRoles))
          )
        )
      );
    }

    function hasChannelWriteAccess(channelId) {
      return isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          channelId != null &&
          exists(/databases/$(database)/documents/forum_channels/$(channelId)) &&
          getUserData().groupId == getChannelData(channelId).groupId &&
          (!getChannelData(channelId).keys().hasAny(['readOnlyForMembers']) || getChannelData(channelId).readOnlyForMembers != true) &&
          (
            getChannelData(channelId).writeRoles == null ||
            getChannelData(channelId).writeRoles.size() == 0 ||
            getChannelData(channelId).writeRoles.hasAny(['all']) ||
            (getChannelData(channelId).keys().hasAny(['allowedRoles']) && getChannelData(channelId).allowedRoles.hasAny(['all'])) ||
            getChannelData(channelId).writeRoles.hasAny([getUserData().role]) ||
            (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny(getChannelData(channelId).writeRoles))
          )
        )
      );
    }

    // --- RÈGLES TÉLÉMÉTRIE & BUGS & HUB ---
    match /hub_system_errors/{errorId} {
      // Écriture ouverte à toutes les apps (Manager, Séquenceur, Vitrine) avec validation des champs
      allow create: if request.resource.data.keys().hasAll(['appId', 'timestamp']);
      // Lecture et gestion réservées à l'administrateur du Hub
      allow read, update, delete: if isAuthenticated() && (
        (request.auth.token.admin == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('isSystemAdmin', false) == true ||
          getUserData().get('isAdmin', false) == true ||
          getUserData().get('role', '') == 'super-admin'
        ))
      );
    }

    match /hub_telemetry_daily/{eventId} {
      allow create: if request.resource.data.keys().hasAny(['timestamp', 'eventId', 'type']);
      allow read, update, delete: if isAuthenticated() && (
        (request.auth.token.admin == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('isSystemAdmin', false) == true ||
          getUserData().get('isAdmin', false) == true ||
          getUserData().get('role', '') == 'super-admin'
        ))
      );
    }

    match /hub_tickets/{ticketId} {
      allow create: if isAuthenticated(); // Users can create tickets
      allow read, update, delete: if isAuthenticated() && (
        (request.auth.token.admin == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('isSystemAdmin', false) == true ||
          getUserData().get('isAdmin', false) == true ||
          getUserData().get('role', '') == 'super-admin'
        )) ||
        (resource.data.userId == request.auth.uid)
      );
    }

    match /hub_reviews/{reviewId} {
      allow read: if true; // Reviews are public
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        (request.auth.token.admin == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().get('isSystemAdmin', false) == true ||
          getUserData().get('isAdmin', false) == true ||
          getUserData().get('role', '') == 'super-admin'
        )) ||
        (resource.data.userId == request.auth.uid)
      );
    }

    // Collection Rules

    // Users: Lecture pour tout membre connecté. Écriture réservée au propre profil (sans altérer 'role', 'tags', 'isNew', etc.) ou aux Admins/Mestres.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdminOrMestre() || (
          request.auth.uid == userId && (
            (!request.resource.data.keys().hasAny(['isSystemAdmin']) || request.resource.data.isSystemAdmin == false) &&
            (!request.resource.data.keys().hasAny(['hasAccessLogistique']) || request.resource.data.hasAccessLogistique == false) &&
            (!request.resource.data.keys().hasAny(['paymentStatus']) || request.resource.data.paymentStatus == 'unpaid') &&
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'membre') &&
            (!request.resource.data.keys().hasAny(['statutActuel']) || request.resource.data.statutActuel == 'active') &&
            (!request.resource.data.keys().hasAny(['adhesionBase']) || request.resource.data.adhesionBase == false) &&
            (!request.resource.data.keys().hasAny(['selectedOptions']) || request.resource.data.selectedOptions.size() == 0) &&
            (!request.resource.data.keys().hasAny(['tags']) || request.resource.data.tags.size() == 0)
          )
        ) || (
          request.resource.data.isDependent == true &&
          request.resource.data.managedBy == request.auth.uid && (
            (!request.resource.data.keys().hasAny(['isSystemAdmin']) || request.resource.data.isSystemAdmin == false) &&
            (!request.resource.data.keys().hasAny(['hasAccessLogistique']) || request.resource.data.hasAccessLogistique == false) &&
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'membre') &&
            (!request.resource.data.keys().hasAny(['statutActuel']) || request.resource.data.statutActuel == 'active') &&
            (!request.resource.data.keys().hasAny(['tags']) || request.resource.data.tags.size() == 0)
          )
        )
      );
      allow update: if isAuthenticated() && (
        isAdminOrMestre() || (
          request.auth.uid == userId && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'paymentStatus', 'role', 'isSystemAdmin', 'hasAccessLogistique', 'groupId', 'adhesionBase', 'selectedOptions', 'tags', 'statutActuel', 'isNew'
            ])
          )
        ) || (
          resource.data.managedBy == request.auth.uid &&
          resource.data.isDependent == true && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'paymentStatus', 'role', 'isSystemAdmin', 'hasAccessLogistique', 'groupId', 'adhesionBase', 'selectedOptions', 'tags', 'statutActuel', 'managedBy', 'isDependent', 'isNew'
            ])
          )
        )
      );
      allow delete: if isAdminOrMestre() || (
        isAuthenticated() &&
        resource.data.managedBy == request.auth.uid &&
        resource.data.isDependent == true
      );

      // Parcours pédagogique : chaque membre gère son propre parcours d'aisance.
      // Les admins/mestres peuvent lire le parcours de tout le monde (suivi pédagogique).
      match /parcours/{document=**} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId || isAdminOrMestre()
        );
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Répétition espacée (historique détaillé des quiz par question)
      match /spaced_repetition/{document=**} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId || isAdminOrMestre()
        );
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Certifications / Examens passés
      match /certifications/{document=**} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId || isAdminOrMestre()
        );
        allow write: if isAuthenticated() && (
          request.auth.uid == userId || isAdminOrMestre()
        );
      }
    }

    // Prospects (Inscription publique)
    match /prospects/{prospectId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrMestre();
    }

    // Inventory: Lecture si authentifié. Écriture réservée aux admins/mestres et membres avec badge Logistique/Inventaire.
    // Les membres simples peuvent uniquement mettre à jour l'état et faire des demandes d'emprunt (pendingMovement).
    match /inventory/{item} {
      allow read: if isAuthenticated();
      allow create, delete: if canManageInventory();
      allow update: if canManageInventory() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['etat', 'pendingMovement']));
    }

    match /inventoryParts/{item} {
      allow read: if isAuthenticated();
      allow create, delete: if canManageInventory();
      allow update: if canManageInventory() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'pendingMovement']));
    }

    match /inventory_projects/{item} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    match /instrument_models/{item} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    // Associations: Lecture publique (vitrine, marque et thème). Écriture réservée aux administrateurs/mestres ou membres autorisés.
    match /associations/{assocId} {
      allow read: if true;
      allow write: if isAdminOrMestre() || hasAnyTag(['Vitrine', 'Webmaster', 'Bureau', 'Président', 'Présidente', 'CA']);

      // Règles d'automatisation
      match /automation_rules/{ruleId} {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      // Paramètres secrets (HelloAsso, Brevo) accessibles uniquement aux admins de l'association
      match /private_settings/credentials {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      // Contacts CRM pour le pôle diffusion
      match /contacts_diffusion/{contactId} {
        allow read, write: if isAuthenticated() && getUserData().groupId == assocId;
      }

      // Notes pédagogiques (Mestre)
      match /blocNotes/{noteId} {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      // Métadonnées du Séquenceur (Mestre)
      match /rhythmMetadata/{rhythmId} {
        allow read, write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }

      // Logs des notifications HelloAsso (lecture admin uniquement, écriture via Admin SDK / Cloud Function)
      match /helloasso_logs/{logId} {
        allow read: if isAdminOrMestre() && getUserData().groupId == assocId;
        allow write: if false;
      }

      // Membres de l'association (utilisés par la gestion O Girador)
      match /members/{memberId} {
        allow read: if isAuthenticated() && getUserData().groupId == assocId;
        allow write: if isAdminOrMestre() && getUserData().groupId == assocId;
      }
    }

    // Packs (catalogue public)
    match /premium_packs/{packId} {
      allow read: if true;
      allow write: if false;
    }

    // Abonnements (Mestre / Manager)
    match /subscriptions/{subscriptionId} {
      allow read: if isAdminOrMestre(); // Seuls les admins peuvent voir l'état de l'abonnement
      allow write: if false; // Géré uniquement via Firebase Functions / SDK Admin
    }

    // Announcements: Lecture si authentifié. Écriture réservée aux admins/mestres.
    match /announcements/{announcement} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Documents / Comptes-Rendus : Lecture si authentifié. Écriture réservée aux admins/mestres et membres habilités (badge Secrétariat/Studio).
    match /documents/{document} {
      allow read: if isAuthenticated();
      allow update, delete: if canManageDocs();
      allow create: if canManageDocs() || (
        isAuthenticated() && 
        request.resource.data.type == 'report'
      );
    }

    // Reunions (Comptes-rendus) : Lecture si authentifié. Écriture réservée aux admins/mestres et membres habilités.
    match /reunions/{reunion} {
      allow read: if isAuthenticated();
      allow write: if canManageDocs();
    }

    // Wardrobe Inventory: Lecture si authentifié. Écriture réservée aux admins/mestres et badge Logistique/Costumes.
    match /wardrobeInventory/{item} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    // Costumes & Pièces: Lecture si authentifié. Écriture réservée aux admins/mestres et badge Logistique/Costumes.
    match /costumes/{costume} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    // Couture Projects: Lecture si authentifié. Écriture réservée aux admins/mestres et badge Logistique/Costumes.
    match /coutureProjects/{project} {
      allow read: if isAuthenticated();
      allow write: if canManageInventory();
    }

    // Formations et chorégraphies (Danse / Séquenceur)
    match /choreographies/{choreo} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }
    match /formations_catalogue/{formation} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }
    match /patterns/{pattern} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }
    match /sections/{section} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }
    match /steps/{step} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Agenda Templates
    match /agendaTemplates/{tpl} {
      allow read: if isAuthenticated();
      allow write: if canManageEvents();
    }

    // Rhythms: Lecture si authentifié. Écriture réservée aux admins/mestres.
    match /rhythms/{rhythm} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Signaux du Maître: Lecture si authentifié. Écriture réservée aux admins/mestres.
    match /mestre_signals/{signal} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Workshops: Lecture si authentifié. Écriture réservée aux admins/mestres.
    match /workshops/{workshop} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Notifications queue: Création si authentifié. Lecture/Écriture pour admins/mestres.
    match /notifications_queue/{notif} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdminOrMestre();
    }

    // Campaigns: Lecture si authentifié. Écriture réservée aux admins/mestres.
    match /campaigns/{campaign} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre();
    }

    // Events: Lecture si authentifié ou si isPublic == true. Création/Suppression/Modif globale réservée aux admins/mestres ou badge Agenda.
    // Seule la mise à jour du tableau inscriptions (RSVP) est autorisée aux membres simples sur leur participation.
    match /events/{event} {
      allow read: if isAuthenticated() || (resource != null && resource.data.isPublic == true);
      allow create, delete: if canManageEvents();
      allow update: if isAuthenticated() && (
        canManageEvents() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inscriptions', 'invitesExternes', 'volunteerShifts', 'suggestionsOrdreDuJour', 'compteRenduApprovals', 'votes', 'covoiturage', 'compteRenduStatus', 'compteRenduVaralId']))
      );

      // Sous-collection des commentaires et questions logistiques de l'événement
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.auteurId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (
          resource.data.auteurId == request.auth.uid ||
          canManageEvents() ||
          isModerator()
        );
      }
    }

    // Transactions (Trésorerie) : Interdites d'écriture aux membres simples sans badge Trésorerie
    match /transactions/{transaction} {
      allow read, write: if (canManageTreasury() || isAdminOrMestre()) && (
        resource == null || getUserData().groupId == resource.data.groupId
      );
    }

    // Forum Channels: Lecture si membre autorisé par rôle/tag/transparence, écriture réservée aux admins/créateurs de groupe
    match /forum_channels/{channelId} {
      allow read: if isAuthenticated() && (
        isAdminOrMestre() ||
        (
          getUserData().groupId == resource.data.groupId &&
          (
            resource.data.isTransparent == true ||
            resource.data.readRoles == null ||
            resource.data.readRoles.size() == 0 ||
            resource.data.readRoles.hasAny(['all']) ||
            (resource.data.keys().hasAny(['allowedRoles']) && resource.data.allowedRoles.hasAny(['all'])) ||
            (resource.data.keys().hasAny(['allowedRoles']) && resource.data.allowedRoles.hasAny([getUserData().role])) ||
            resource.data.readRoles.hasAny([getUserData().role]) ||
            (getUserData().keys().hasAny(['tags']) && getUserData().tags.hasAny(resource.data.readRoles))
          )
        )
      );
      allow create: if isAuthenticated() && request.resource.data.groupId == getUserData().groupId;
      allow update, delete: if isAdminOrMestre();
    }

    // Forum Threads: Seul l'auteur du message, un modérateur ou un admin/mestre peut modifier ou supprimer son fil/message
    match /forum/{thread} {
      allow read: if isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        hasChannelReadAccess(resource.data.channelId)
      );
      allow create: if isAuthenticated() && (
        hasChannelWriteAccess(request.resource.data.channelId)
      );
      allow update: if isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          resource.data.authorId == request.auth.uid &&
          (hasChannelWriteAccess(resource.data.channelId) || !resource.data.keys().hasAny(['channelId'])) &&
          (!request.resource.data.keys().hasAny(['channelId']) || request.resource.data.channelId == resource.data.channelId)
        ) ||
        (
          hasChannelWriteAccess(resource.data.channelId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponses', 'derniereModification', 'poll'])
        )
      );
      allow delete: if isAdminOrMestre() || isModerator() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    match /forum_posts/{post} {
      allow read: if isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        hasChannelReadAccess(resource.data.channelId)
      );
      allow create: if isAuthenticated() && (
        hasChannelWriteAccess(request.resource.data.channelId)
      );
      allow update: if isAuthenticated() && (
        isAdminOrMestre() ||
        isModerator() ||
        (
          resource.data.authorId == request.auth.uid &&
          (hasChannelWriteAccess(resource.data.channelId) || !resource.data.keys().hasAny(['channelId'])) &&
          (!request.resource.data.keys().hasAny(['channelId']) || request.resource.data.channelId == resource.data.channelId)
        ) ||
        (
          hasChannelWriteAccess(resource.data.channelId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponses', 'derniereModification', 'poll'])
        )
      );
      allow delete: if isAdminOrMestre() || isModerator() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Campaign Requests (Commandes d'articles) : Création et modification restreintes au demandeur propriétaire ou aux admins
    match /campaignRequests/{req} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || canManageInventory()
      );
    }

    // Messages privés: Restreints à l'expéditeur et au destinataire
    match /private_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid &&
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
      );
      allow delete: if false;
    }

    // Factures & Devis : Lecture et écriture réservées aux membres habilités Trésorerie / Admin
    match /invoices/{invoice} {
      allow read: if isAuthenticated();
      allow write: if canManageTreasury();
    }

    // Pipeline Prestations (Pôle Diffusion) : Lecture et écriture réservées aux membres habilités Diffusion / Admin
    match /gigs_pipeline/{gig} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrMestre() || hasAnyTag(['Diffusion', 'Booking', 'Bureau', 'CA', 'Communication']);
    }

    // Pending payments: Réservé aux admins et mestres
    match /pending_payments/{email} {
      allow read, write: if isAdminOrMestre();
    }

    // Newsletter subscribers: Inscription publique autorisée (create), lecture/export réservés aux admins/mestres
    match /newsletter_subscribers/{subscriberDoc} {
      allow create: if request.resource.data.keys().hasAll(['email']);
      allow read, update, delete: if isAdminOrMestre();
    }

    // QR Code Sessions (WhatsApp Web login) : Création et écoute temps réel autorisées,
    // mise à jour directe interdite (mise à jour réservée aux Cloud Functions / Admin SDK).
    match /qr_sessions/{sessionId} {
      allow create: if true;
      allow read: if true;
      allow delete: if isAuthenticated();
      allow update: if false;
    }
  }
}
