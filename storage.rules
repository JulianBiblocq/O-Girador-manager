rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Règle d'accès globale au stockage pour l'application O Girador Manager
    match /{allPaths=**} {
      // Lecture publique autorisée (photos, logos, documents vitrine, avatars)
      allow read: if true;
      // Écriture (upload / suppression) autorisée pour tout membre authentifié
      allow write: if request.auth != null;
    }
  }
}
