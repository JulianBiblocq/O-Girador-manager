rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Photos de profil / Avatars : Lecture publique (Trombinoscope/Vitrine), Ã©criture par le propriÃ©taire ou un Admin
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin' || request.auth.token.role == 'mestre');
    }

    // 2. Fichiers Vitrine & Association (Logos, PDFs Dossiers Pro, Images Hero) : Lecture publique, Upload rÃ©servÃ© aux membres connectÃ©s
    match /associations/{groupId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Documents internes (Varal, Partitions, Comptes-Rendus, SÃ©quenceur) : Accessible uniquement aux membres connectÃ©s
    match /documents/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 4. MÃ©dia des Ateliers / Workshops : Accessible aux membres connectÃ©s
    match /workshops_media/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 4b. Images du Forum : Accessible aux membres connectés
    match /forum_images/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 5. MÃ©dia Studio Social & Justificatifs : Membres connectÃ©s
    match /studio_validation/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 6. Justificatifs de commandes
    match /orders/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 7. Justificatifs de trÃ©sorerie (OpÃ©rations)
    match /transactions/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 8. Autorisation spÃ©cifique pour l'export "Danse" du sÃ©quenceur
    match /exports_danse/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource != null 
                   && request.resource.size < 100 * 1024 * 1024 
                   && request.resource.contentType != null
                   && request.resource.contentType.matches('^(audio|video)/.*');
    }

    // 9. Dancador Studio Capture (Vidéos des pas)
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 500 * 1024 * 1024 
                   && request.resource.contentType.matches('^video/.*');
    }

    // 10. Dancador Studio Capture (Images / Silhouettes)
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024 
                   && request.resource.contentType.matches('^image/.*');
    }

    // RÃ¨gle de sÃ©curitÃ© par dÃ©faut : Tout autre chemin non explicitement dÃ©fini est VÃ‰ROUILLÃ‰
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
